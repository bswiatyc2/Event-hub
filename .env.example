# Copy this file to .env and replace values before running the app.
# Never commit your real .env file.

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-real-random-key

# SQLite local path (relative to project root). The instance/ folder is created
# automatically by Flask the first time the app starts.
DATABASE_URL=sqlite:///instance/eventhub.db

# Flask CLI configuration
FLASK_APP=app.py
FLASK_DEBUG=1
